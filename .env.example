# Service account Google (jangan commit nilai asli)
GOOGLE_SERVICE_ACCOUNT_EMAIL=nama@project-id.iam.gserviceaccount.com
# Salin private_key dari file JSON apa adanya (boleh dengan \n literal), bungkus tanda kutip
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
SPREADSHEET_ID=
# Secret penanda cookie sesi, minimal 32 karakter acak: openssl rand -base64 48
SESSION_SECRET=

# Opsional (nilai default di bawah)
CONTACTS_SHEET=delivery_kitchen
BATCH_SIZE=10
CLAIM_TIMEOUT_MIN=60
PACING_SECONDS_MIN=20
PACING_SECONDS_MAX=60
